{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{data/cases/**,data/scoreboard.json,src/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/askfacts.js", "destination": "/api/index.js" },
    { "source": "/validate.js", "destination": "/api/index.js" }
  ]
}
