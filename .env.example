# Copy to .env and fill in. Everything works without these; they add optional layers.

# Google AI Studio key. Enables photo extraction, friendlier explanations, and the AI billing rep.
GEMINI_API_KEY=
# GEMINI_MODEL is the model used for document extraction (reading bill/EOB photos and PDFs),
# explanation rewording and the practice billing rep. Set it to a currently available
# MULTIMODAL Gemini model (it must accept images and PDFs) that your API key can use.
# Check the model list in Google AI Studio. SecondLook never switches models on its own:
# if this model is missing, retired or not allowed for your key, you'll see an error naming it.
# Default if unset: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs key (free plan is fine). Enables natural voices for read-aloud and call practice.
ELEVENLABS_API_KEY=
# Default voice is "Rachel", a premade voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# PORT=3000

# Supabase (name-only sign-in + each user's saved analyses and disputes). Needs "Allow anonymous sign-ins"
# turned on and db/schema.sql run once. The anon key is public by design; never put the service role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
